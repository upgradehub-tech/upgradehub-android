diff --git a/app/api/admin/announcements/route.ts b/app/api/admin/announcements/route.ts
new file mode 100644
index 0000000..3f2b8a1
--- /dev/null
+++ b/app/api/admin/announcements/route.ts
@@ -0,0 +1,97 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { isErrorResponse, requireAdmin, writeAudit } from '@/lib/auth/server';
+import { jsonError, readJson } from '@/lib/http';
+import { isUuid, parseAnnouncementInput, parseAnnouncementPatch } from '@/lib/admin/validators';
+import { dispatchQueuedNotifications } from '@/lib/notifications/fcm';
+
+export const runtime = 'nodejs';
+export const dynamic = 'force-dynamic';
+export const maxDuration = 60;
+
+export async function GET(req: NextRequest) {
+  const ctx = await requireAdmin(req);
+  if (isErrorResponse(ctx)) return ctx;
+  const { data, error } = await ctx.db.from('announcements').select('*').order('created_at', { ascending: false }).limit(50);
+  if (error) {
+    console.error('[admin/announcements] list:', error.message);
+    return jsonError('Could not load announcements.', 'SERVER_ERROR', 500);
+  }
+  return NextResponse.json({ items: data });
+}
+
+export async function POST(req: NextRequest) {
+  const ctx = await requireAdmin(req);
+  if (isErrorResponse(ctx)) return ctx;
+
+  const body = await readJson(req);
+  if (!body.ok) return body.response;
+  const parsed = parseAnnouncementInput(body.value);
+  if (!parsed.ok) return jsonError(parsed.error, 'BAD_REQUEST', 400);
+
+  const { data, error } = await ctx.db
+    .from('announcements')
+    .insert({ ...parsed.value, status: 'draft', created_by: ctx.userId })
+    .select()
+    .single();
+  if (error || !data) {
+    console.error('[admin/announcements] insert:', error?.message);
+    return jsonError('Could not create announcement.', 'SERVER_ERROR', 500);
+  }
+  await writeAudit(ctx, 'announcement.create', 'announcement', data.id, { title: data.title });
+  return NextResponse.json({ item: data }, { status: 201 });
+}
+
+export async function PATCH(req: NextRequest) {
+  const ctx = await requireAdmin(req);
+  if (isErrorResponse(ctx)) return ctx;
+
+  const body = await readJson(req);
+  if (!body.ok) return body.response;
+  const parsed = parseAnnouncementPatch(body.value);
+  if (!parsed.ok) return jsonError(parsed.error, 'BAD_REQUEST', 400);
+  const { id, publish, archive, ...fields } = parsed.value;
+
+  const update: Record<string, unknown> = { ...fields };
+  if (publish) { update.status = 'published'; update.published_at = new Date().toISOString(); }
+  if (archive) update.status = 'archived';
+  if (Object.keys(update).length === 0) return jsonError('Nothing to update.', 'BAD_REQUEST', 400);
+
+  const { data, error } = await ctx.db.from('announcements').update(update).eq('id', id).select().maybeSingle();
+  if (error) {
+    console.error('[admin/announcements] update:', error.message);
+    return jsonError('Could not update announcement.', 'SERVER_ERROR', 500);
+  }
+  if (!data) return jsonError('Announcement not found.', 'NOT_FOUND', 404);
+  await writeAudit(ctx, publish ? 'announcement.publish' : archive ? 'announcement.archive' : 'announcement.update', 'announcement', id);
+
+  let queued = 0;
+  let dispatch: unknown = null;
+  if (publish) {
+    // Idempotent: dobara publish karne par 0 naye rows (unique(user_id, dedupe_key)).
+    const { data: count, error: qErr } = await ctx.db.rpc('enqueue_announcement_notifications', { p_announcement_id: id });
+    if (qErr) console.error('[admin/announcements] enqueue:', qErr.message);
+    else queued = typeof count === 'number' ? count : 0;
+    try {
+      dispatch = await dispatchQueuedNotifications();
+    } catch (e) {
+      console.error('[admin/announcements] dispatch:', e instanceof Error ? e.message : e);
+      dispatch = { error: 'dispatch_failed' };   // rows 'queued' rehti hain; cron retry karega
+    }
+  }
+  return NextResponse.json({ item: data, queued, dispatch });
+}
+
+export async function DELETE(req: NextRequest) {
+  const ctx = await requireAdmin(req);
+  if (isErrorResponse(ctx)) return ctx;
+  const id = new URL(req.url).searchParams.get('id');
+  if (!isUuid(id)) return jsonError('valid id is required', 'BAD_REQUEST', 400);
+
+  const { error } = await ctx.db.from('announcements').delete().eq('id', id);
+  if (error) {
+    console.error('[admin/announcements] delete:', error.message);
+    return jsonError('Could not delete announcement.', 'SERVER_ERROR', 500);
+  }
+  await writeAudit(ctx, 'announcement.delete', 'announcement', id);
+  return NextResponse.json({ ok: true });
+}
