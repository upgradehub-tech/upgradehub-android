diff --git a/scripts/regression-check.mjs b/scripts/regression-check.mjs
new file mode 100644
index 0000000..6404c25
--- /dev/null
+++ b/scripts/regression-check.mjs
@@ -0,0 +1,80 @@
+// Static regression gate: node scripts/regression-check.mjs
+import { readFileSync, readdirSync, existsSync, statSync } from 'node:fs';
+import { join, relative } from 'node:path';
+
+const root = process.cwd();
+const failures = [];
+const passes = [];
+const check = (name, ok, detail = '') => (ok ? passes : failures).push(detail ? `${name}: ${detail}` : name);
+const read = (p) => readFileSync(join(root, p), 'utf8');
+const walk = (dir) => {
+  if (!existsSync(join(root, dir))) return [];
+  return readdirSync(join(root, dir)).flatMap((n) => {
+    if (n === 'node_modules' || n === '.next') return [];
+    const rel = join(dir, n);
+    return statSync(join(root, rel)).isDirectory() ? walk(rel) : [rel];
+  });
+};
+
+// 1) Day 1-8 modules still present
+for (const f of [
+  'types/campus-rewards.ts', 'types/study-coach.ts', 'hooks/useAICoach.ts',
+  'components/AICoachDashboard.tsx', 'components/CampusAndRewardsHub.tsx', 'components/AuthGate.tsx',
+  'lib/supabase/client.ts', 'lib/supabase/verify-user.ts', 'app/api/ai/coach/route.ts',
+  'supabase/migrations/001_init.sql',
+]) check(`module present: ${f}`, existsSync(join(root, f)));
+
+// 2) AI coach route keeps its protections
+const coach = read('app/api/ai/coach/route.ts');
+check('coach: exports POST', /export async function POST/.test(coach));
+check('coach: requires verified user', /getVerifiedUserId\(req\)/.test(coach));
+check('coach: key sent in header not URL', /x-goog-api-key/.test(coach) && !/\?key=/.test(coach));
+check('coach: rate limit present', /isRateLimited/.test(coach));
+
+// 3) Every migration table has RLS enabled; no open policies
+const sql = walk('supabase/migrations').filter((f) => f.endsWith('.sql')).map((f) => [f, read(f)]);
+const allSql = sql.map(([, s]) => s).join('\n');
+for (const m of allSql.matchAll(/create table if not exists public\.(\w+)/gi)) {
+  const t = m[1];
+  check(`RLS enabled on public.${t}`, new RegExp(`alter table public\\.${t} enable row level security`, 'i').test(allSql));
+}
+check('no wide-open policies (using true / with check true)', !/(using|with check)\s*\(\s*true\s*\)/i.test(allSql));
+check('anon revoked on admin tables', ['announcements', 'syllabus_items', 'device_tokens', 'notification_log', 'user_roles', 'admin_audit_log']
+  .every((t) => new RegExp(`revoke all on public\\.${t} from anon`, 'i').test(allSql)));
+check('user_roles not writable by clients', /revoke all on public\.user_roles from anon, authenticated/i.test(allSql) && /grant select on public\.user_roles/i.test(allSql));
+check('notification dedupe unique constraint', /unique \(user_id, dedupe_key\)/i.test(allSql));
+check('SECURITY DEFINER functions pin search_path', [...allSql.matchAll(/security definer/gi)].length === [...allSql.matchAll(/security definer\s+set search_path = ''/gi)].length
+  || [...allSql.matchAll(/language \w+\s+(?:stable\s+)?security definer\s+set search_path = ''/gi)].length >= 3);
+
+// 4) Secrets never reach client bundles
+const clientFiles = [...walk('components'), ...walk('hooks'), 'lib/supabase/client.ts'].filter((f) => /\.(ts|tsx)$/.test(f));
+for (const f of clientFiles) {
+  const s = read(f);
+  check(`no server secret in client file ${f}`, !/SERVICE_ROLE|FIREBASE_SERVICE_ACCOUNT|GEMINI_API_KEY|CRON_SECRET/.test(s));
+}
+const all = [...walk('app'), ...walk('lib'), ...walk('components'), ...walk('hooks')].filter((f) => /\.(ts|tsx)$/.test(f));
+check('no NEXT_PUBLIC_ secret variables', !all.some((f) => /NEXT_PUBLIC_[A-Z_]*(SERVICE_ROLE|GEMINI|FIREBASE_SERVICE|CRON)/.test(read(f))));
+check('service_role used only in lib/notifications/fcm.ts', all.filter((f) => /SUPABASE_SERVICE_ROLE_KEY/.test(read(f))).every((f) => f.replace(/\\/g, '/') === 'lib/notifications/fcm.ts'));
+check('fcm.ts is only imported by server routes', all.filter((f) => /notifications\/fcm/.test(read(f)) && !f.replace(/\\/g, '/').startsWith('app/api/') && !f.endsWith('fcm.ts')).length === 0);
+
+// 5) Admin endpoints are gated
+for (const f of walk('app/api/admin').filter((f) => f.endsWith('route.ts'))) {
+  const s = read(f);
+  const handlers = [...s.matchAll(/export async function (GET|POST|PATCH|DELETE|PUT)/g)].map((m) => m[1]);
+  const gates = [...s.matchAll(/await (requireAdmin|requireUser)\(req\)/g)].length;
+  check(`${f}: every handler authenticates`, handlers.length > 0 && gates >= handlers.length, `${handlers.length} handlers / ${gates} gates`);
+  const mutating = s.split(/export async function /).slice(1).filter((b) => /^(POST|PATCH|DELETE|PUT)/.test(b));
+  check(`${f}: every mutating handler uses requireAdmin`, mutating.every((b) => /requireAdmin\(req\)/.test(b)));
+}
+check('internal dispatch protected by CRON_SECRET', /CRON_SECRET/.test(read('app/api/internal/notifications/dispatch/route.ts')) && /timingSafeEqual/.test(read('app/api/internal/notifications/dispatch/route.ts')));
+check('device register requires user', /requireUser\(req\)/.test(read('app/api/devices/register/route.ts')));
+
+// 6) Repo hygiene
+const gi = read('.gitignore');
+check('.gitignore covers .env*.local', /\.env\*\.local/.test(gi));
+check('next.config keeps security headers', /X-Frame-Options/.test(read('next.config.mjs')));
+
+console.log(`\nPASS ${passes.length}   FAIL ${failures.length}\n`);
+for (const f of failures) console.log('  ✗', f);
+if (failures.length) { console.log('\nRegression check FAILED'); process.exit(1); }
+console.log('Regression check passed');
diff --git a/supabase/migrations/002_admin_device_layer.sql b/supabase/migrations/002_admin_device_layer.sql
