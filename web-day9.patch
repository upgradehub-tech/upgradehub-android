@@ -0,0 +1,200 @@
+-- Day 9: Admin authorization + announcements/syllabus + device tokens + notification dedupe
+-- Run: Supabase Dashboard -> SQL Editor -> paste -> Run   (001_init.sql pehle chal chuka hona chahiye)
+
+-- ============ Shared helper ============
+create or replace function public.set_updated_at()
+returns trigger language plpgsql set search_path = '' as $$
+begin new.updated_at = now(); return new; end; $$;
+
+-- ============ 1) Roles (trusted: client kabhi write nahi kar sakta) ============
+create table if not exists public.user_roles (
+  user_id    uuid primary key references auth.users(id) on delete cascade,
+  role       text not null default 'student' check (role in ('student','moderator','admin')),
+  granted_at timestamptz not null default now()
+);
+alter table public.user_roles enable row level security;
+drop policy if exists "user_roles_select_own" on public.user_roles;
+create policy "user_roles_select_own" on public.user_roles
+  for select to authenticated using ((select auth.uid()) = user_id);
+revoke all on public.user_roles from anon, authenticated;
+grant select on public.user_roles to authenticated;   -- insert/update/delete: sirf SQL Editor / service_role
+
+create or replace function public.is_admin()
+returns boolean language sql stable security definer set search_path = '' as $$
+  select exists (
+    select 1 from public.user_roles
+    where user_id = (select auth.uid()) and role = 'admin'
+  );
+$$;
+revoke execute on function public.is_admin() from public, anon;
+grant  execute on function public.is_admin() to authenticated;
+
+-- ============ 2) Announcements ============
+create table if not exists public.announcements (
+  id           uuid primary key default gen_random_uuid(),
+  title        text not null check (char_length(title) between 3 and 120),
+  body         text not null check (char_length(body)  between 1 and 2000),
+  audience     text not null default 'all' check (audience in ('all','batch','no_batch')),
+  status       text not null default 'draft' check (status in ('draft','published','archived')),
+  published_at timestamptz,
+  created_by   uuid references auth.users(id) on delete set null,
+  created_at   timestamptz not null default now(),
+  updated_at   timestamptz not null default now()
+);
+alter table public.announcements enable row level security;
+drop trigger if exists announcements_updated_at on public.announcements;
+create trigger announcements_updated_at before update on public.announcements
+  for each row execute function public.set_updated_at();
+
+drop policy if exists "announcements_read" on public.announcements;
+drop policy if exists "announcements_admin_insert" on public.announcements;
+drop policy if exists "announcements_admin_update" on public.announcements;
+drop policy if exists "announcements_admin_delete" on public.announcements;
+create policy "announcements_read" on public.announcements
+  for select to authenticated using (status = 'published' or (select public.is_admin()));
+create policy "announcements_admin_insert" on public.announcements
+  for insert to authenticated with check ((select public.is_admin()));
+create policy "announcements_admin_update" on public.announcements
+  for update to authenticated using ((select public.is_admin())) with check ((select public.is_admin()));
+create policy "announcements_admin_delete" on public.announcements
+  for delete to authenticated using ((select public.is_admin()));
+revoke all on public.announcements from anon;
+
+-- ============ 3) Syllabus ============
+create table if not exists public.syllabus_items (
+  id          uuid primary key default gen_random_uuid(),
+  subject     text not null check (char_length(subject) between 2 and 50),
+  chapter     text not null check (char_length(chapter) between 2 and 100),
+  topic       text not null check (char_length(topic)   between 1 and 120),
+  sort_order  integer not null default 0 check (sort_order between 0 and 10000),
+  is_active   boolean not null default true,
+  created_by  uuid references auth.users(id) on delete set null,
+  created_at  timestamptz not null default now(),
+  updated_at  timestamptz not null default now(),
+  unique (subject, chapter, topic)
+);
+alter table public.syllabus_items enable row level security;
+drop trigger if exists syllabus_items_updated_at on public.syllabus_items;
+create trigger syllabus_items_updated_at before update on public.syllabus_items
+  for each row execute function public.set_updated_at();
+
+drop policy if exists "syllabus_read" on public.syllabus_items;
+drop policy if exists "syllabus_admin_insert" on public.syllabus_items;
+drop policy if exists "syllabus_admin_update" on public.syllabus_items;
+drop policy if exists "syllabus_admin_delete" on public.syllabus_items;
+create policy "syllabus_read" on public.syllabus_items
+  for select to authenticated using (is_active or (select public.is_admin()));
+create policy "syllabus_admin_insert" on public.syllabus_items
+  for insert to authenticated with check ((select public.is_admin()));
+create policy "syllabus_admin_update" on public.syllabus_items
+  for update to authenticated using ((select public.is_admin())) with check ((select public.is_admin()));
+create policy "syllabus_admin_delete" on public.syllabus_items
+  for delete to authenticated using ((select public.is_admin()));
+revoke all on public.syllabus_items from anon;
+
+-- ============ 4) Device tokens (FCM) ============
+create table if not exists public.device_tokens (
+  id           uuid primary key default gen_random_uuid(),
+  user_id      uuid not null references auth.users(id) on delete cascade,
+  fcm_token    text not null unique check (char_length(fcm_token) between 20 and 4096),
+  platform     text not null check (platform in ('android','ios','web')),
+  app_version  text check (app_version is null or char_length(app_version) <= 32),
+  last_seen_at timestamptz not null default now(),
+  created_at   timestamptz not null default now()
+);
+create index if not exists device_tokens_user_idx on public.device_tokens(user_id);
+alter table public.device_tokens enable row level security;
+drop policy if exists "device_tokens_select_own" on public.device_tokens;
+drop policy if exists "device_tokens_delete_own" on public.device_tokens;
+create policy "device_tokens_select_own" on public.device_tokens
+  for select to authenticated using ((select auth.uid()) = user_id);
+create policy "device_tokens_delete_own" on public.device_tokens
+  for delete to authenticated using ((select auth.uid()) = user_id);
+revoke all on public.device_tokens from anon, authenticated;
+grant select, delete on public.device_tokens to authenticated;  -- insert/update sirf RPC se
+
+create or replace function public.register_device_token(p_token text, p_platform text, p_app_version text default null)
+returns void language plpgsql security definer set search_path = '' as $$
+declare v_uid uuid := (select auth.uid());
+begin
+  if v_uid is null then raise exception 'not authenticated' using errcode = '28000'; end if;
+  if p_token is null or char_length(p_token) < 20 or char_length(p_token) > 4096 then
+    raise exception 'invalid token' using errcode = '22023';
+  end if;
+  if p_platform not in ('android','ios','web') then
+    raise exception 'invalid platform' using errcode = '22023';
+  end if;
+  -- Shared phone: token naye logged-in user ko transfer ho jaata hai (purane user ko push nahi jayega)
+  insert into public.device_tokens (user_id, fcm_token, platform, app_version, last_seen_at)
+  values (v_uid, p_token, p_platform, left(p_app_version, 32), now())
+  on conflict (fcm_token) do update
+    set user_id = excluded.user_id, platform = excluded.platform,
+        app_version = excluded.app_version, last_seen_at = now();
+end; $$;
+revoke execute on function public.register_device_token(text, text, text) from public, anon;
+grant  execute on function public.register_device_token(text, text, text) to authenticated;
+
+-- ============ 5) Notification log = duplicate control ============
+create table if not exists public.notification_log (
+  id         uuid primary key default gen_random_uuid(),
+  user_id    uuid not null references auth.users(id) on delete cascade,
+  dedupe_key text not null check (char_length(dedupe_key) between 3 and 128),
+  kind       text not null check (kind in ('announcement','syllabus','slot_reminder')),
+  title      text not null,
+  body       text not null,
+  status     text not null default 'queued' check (status in ('queued','sending','sent','failed')),
+  created_at timestamptz not null default now(),
+  sent_at    timestamptz,
+  unique (user_id, dedupe_key)            -- ek user ko ek event ka sirf ek notification
+);
+create index if not exists notification_log_status_idx on public.notification_log(status, created_at);
+alter table public.notification_log enable row level security;
+drop policy if exists "notification_log_select_own" on public.notification_log;
+create policy "notification_log_select_own" on public.notification_log
+  for select to authenticated using ((select auth.uid()) = user_id);
+revoke all on public.notification_log from anon, authenticated;
+grant select on public.notification_log to authenticated;
+
+create or replace function public.enqueue_announcement_notifications(p_announcement_id uuid)
+returns integer language plpgsql security definer set search_path = '' as $$
+declare v_count integer; v_title text; v_body text; v_status text;
+begin
+  if not public.is_admin() then raise exception 'forbidden' using errcode = '42501'; end if;
+  select title, body, status into v_title, v_body, v_status
+    from public.announcements where id = p_announcement_id;
+  if not found then raise exception 'announcement not found' using errcode = 'P0002'; end if;
+  if v_status <> 'published' then raise exception 'announcement not published' using errcode = '22023'; end if;
+
+  insert into public.notification_log (user_id, dedupe_key, kind, title, body)
+  select distinct dt.user_id, 'announcement:' || p_announcement_id::text, 'announcement', v_title, left(v_body, 500)
+  from public.device_tokens dt
+  on conflict (user_id, dedupe_key) do nothing;     -- dobara publish = 0 naye rows
+  get diagnostics v_count = row_count;
+  return v_count;
+end; $$;
+revoke execute on function public.enqueue_announcement_notifications(uuid) from public, anon;
+grant  execute on function public.enqueue_announcement_notifications(uuid) to authenticated;
+
+-- ============ 6) Admin audit log ============
+create table if not exists public.admin_audit_log (
+  id         uuid primary key default gen_random_uuid(),
+  actor_id   uuid not null references auth.users(id) on delete cascade,
+  action     text not null,
+  entity     text not null,
+  entity_id  text,
+  meta       jsonb not null default '{}'::jsonb,
+  created_at timestamptz not null default now()
+);
+alter table public.admin_audit_log enable row level security;
+drop policy if exists "audit_admin_select" on public.admin_audit_log;
+drop policy if exists "audit_admin_insert" on public.admin_audit_log;
+create policy "audit_admin_select" on public.admin_audit_log
+  for select to authenticated using ((select public.is_admin()));
+create policy "audit_admin_insert" on public.admin_audit_log
+  for insert to authenticated with check ((select public.is_admin()) and actor_id = (select auth.uid()));
+revoke all on public.admin_audit_log from anon, authenticated;
+grant select, insert on public.admin_audit_log to authenticated;   -- update/delete nahi: log tamper-proof
+
+-- ============ Pehla admin banane ke liye (SQL Editor mein, apna user id daalo) ============
+-- insert into public.user_roles (user_id, role) values ('<YOUR-AUTH-USER-UUID>', 'admin')
+--   on conflict (user_id) do update set role = 'admin';
diff --git a/tests/dedupe.test.ts b/tests/dedupe.test.ts
new file mode 100644
index 0000000..fe412fd
--- /dev/null
+++ b/tests/dedupe.test.ts
@@ -0,0 +1,37 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { RecentKeyGuard, buildDedupeKey, uniqueByUserAndKey } from '../lib/notifications/dedupe';
+
+test('buildDedupeKey is stable and validates input', () => {
+  assert.equal(buildDedupeKey('announcement', 'abc-123'), 'announcement:abc-123');
+  assert.equal(buildDedupeKey('slot_reminder', 'slot1', '2026-10-24'), 'slot_reminder:slot1:2026-10-24');
+  assert.equal(buildDedupeKey('announcement', 'abc-123'), buildDedupeKey('announcement', 'abc-123'));
+  assert.throws(() => buildDedupeKey('announcement', 'bad id'));
+  assert.throws(() => buildDedupeKey('announcement', "x'; drop table"));
+  assert.throws(() => buildDedupeKey('announcement', 'ok', 'bad scope'));
+});
+
+test('uniqueByUserAndKey keeps first, same user different key survives', () => {
+  const rows = [
+    { user_id: 'u1', dedupe_key: 'k1', n: 1 },
+    { user_id: 'u1', dedupe_key: 'k1', n: 2 },
+    { user_id: 'u1', dedupe_key: 'k2', n: 3 },
+    { user_id: 'u2', dedupe_key: 'k1', n: 4 },
+  ];
+  assert.deepEqual(uniqueByUserAndKey(rows).map((r) => r.n), [1, 3, 4]);
+});
+
+test('RecentKeyGuard blocks inside the window and allows after it', () => {
+  const g = new RecentKeyGuard(30_000);
+  assert.equal(g.isDuplicate('a', 1_000), false);
+  assert.equal(g.isDuplicate('a', 20_000), true);
+  assert.equal(g.isDuplicate('b', 20_000), false);
+  assert.equal(g.isDuplicate('a', 31_001), false);
+});
+
+test('RecentKeyGuard memory stays bounded', () => {
+  const g = new RecentKeyGuard(1_000_000, 50);
+  for (let i = 0; i < 500; i++) g.isDuplicate(`k${i}`, i);
+  assert.equal(g.isDuplicate('k499', 600), true);    // recent key still remembered
+  assert.equal(g.isDuplicate('k0', 600), false);     // oldest evicted
+});
diff --git a/tests/validators.test.ts b/tests/validators.test.ts
new file mode 100644
index 0000000..de63a51
--- /dev/null
+++ b/tests/validators.test.ts
@@ -0,0 +1,63 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  parseAnnouncementInput, parseAnnouncementPatch, parseDeviceInput, parseSyllabusInput, parseSyllabusPatch, isUuid,
+} from '../lib/admin/validators';
+
+const UUID = '123e4567-e89b-12d3-a456-426614174000';
+
+test('announcement: valid input is trimmed and defaulted', () => {
+  const r = parseAnnouncementInput({ title: '  Mock test Sunday  ', body: 'Be ready' });
+  assert.ok(r.ok);
+  if (r.ok) { assert.equal(r.value.title, 'Mock test Sunday'); assert.equal(r.value.audience, 'all'); }
+});
+
+test('announcement: rejects short title, long body, bad audience, non-object', () => {
+  assert.equal(parseAnnouncementInput({ title: 'ab', body: 'x' }).ok, false);
+  assert.equal(parseAnnouncementInput({ title: 'Valid', body: 'x'.repeat(2001) }).ok, false);
+  assert.equal(parseAnnouncementInput({ title: 'Valid', body: 'x', audience: 'admins' }).ok, false);
+  assert.equal(parseAnnouncementInput(null).ok, false);
+  assert.equal(parseAnnouncementInput('str').ok, false);
+  assert.equal(parseAnnouncementInput([]).ok, false);
+});
+
+test('announcement: control characters are stripped, title newlines flattened', () => {
+  const r = parseAnnouncementInput({ title: 'Hello\u0000\nWorld', body: 'a\u0007b' });
+  assert.ok(r.ok);
+  if (r.ok) { assert.equal(r.value.title, 'Hello World'); assert.equal(r.value.body, 'ab'); }
+});
+
+test('announcement patch: needs uuid, publish+archive conflict rejected', () => {
+  assert.equal(parseAnnouncementPatch({ id: 'nope', publish: true }).ok, false);
+  assert.equal(parseAnnouncementPatch({ id: UUID, publish: true, archive: true }).ok, false);
+  const r = parseAnnouncementPatch({ id: UUID, publish: true, role: 'admin', status: 'published' });
+  assert.ok(r.ok);
+  if (r.ok) assert.deepEqual(Object.keys(r.value).sort(), ['id', 'publish']);   // unknown/mass-assignment fields drop
+});
+
+test('syllabus: valid, bad sortOrder, non-boolean isActive', () => {
+  assert.ok(parseSyllabusInput({ subject: 'Physics', chapter: 'Rotation', topic: 'Torque' }).ok);
+  assert.equal(parseSyllabusInput({ subject: 'Physics', chapter: 'Rotation', topic: 'T', sortOrder: -1 }).ok, false);
+  assert.equal(parseSyllabusInput({ subject: 'Physics', chapter: 'Rotation', topic: 'T', sortOrder: 1.5 }).ok, false);
+  assert.equal(parseSyllabusInput({ subject: 'Physics', chapter: 'Rotation', topic: 'T', isActive: 'yes' }).ok, false);
+});
+
+test('syllabus patch: empty patch rejected', () => {
+  assert.equal(parseSyllabusPatch({ id: UUID }).ok, false);
+  assert.ok(parseSyllabusPatch({ id: UUID, isActive: false }).ok);
+});
+
+test('device: token/platform validation', () => {
+  const token = 'a'.repeat(40);
+  assert.ok(parseDeviceInput({ token, platform: 'android', appVersion: '1.0' }).ok);
+  assert.equal(parseDeviceInput({ token: 'short', platform: 'android' }).ok, false);
+  assert.equal(parseDeviceInput({ token: 'a b'.repeat(20), platform: 'android' }).ok, false);
+  assert.equal(parseDeviceInput({ token, platform: 'symbian' }).ok, false);
+  assert.equal(parseDeviceInput({ token, platform: 'web', appVersion: 'v'.repeat(33) }).ok, false);
+});
+
+test('isUuid', () => {
+  assert.ok(isUuid(UUID));
+  assert.equal(isUuid('123'), false);
+  assert.equal(isUuid(undefined), false);
+});
