@@ -0,0 +1,85 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { isErrorResponse, requireAdmin, requireUser, writeAudit } from '@/lib/auth/server';
+import { jsonError, readJson } from '@/lib/http';
+import { isUuid, parseSyllabusInput, parseSyllabusPatch } from '@/lib/admin/validators';
+
+export const runtime = 'nodejs';
+export const dynamic = 'force-dynamic';
+
+// Students bhi active syllabus padh sakte hain (RLS sirf is_active dikhata hai); admin sab dekhta hai.
+export async function GET(req: NextRequest) {
+  const ctx = await requireUser(req);
+  if (isErrorResponse(ctx)) return ctx;
+  const { data, error } = await ctx.db
+    .from('syllabus_items')
+    .select('*')
+    .order('subject')
+    .order('sort_order')
+    .limit(1000);
+  if (error) {
+    console.error('[admin/syllabus] list:', error.message);
+    return jsonError('Could not load syllabus.', 'SERVER_ERROR', 500);
+  }
+  return NextResponse.json({ items: data });
+}
+
+export async function POST(req: NextRequest) {
+  const ctx = await requireAdmin(req);
+  if (isErrorResponse(ctx)) return ctx;
+  const body = await readJson(req);
+  if (!body.ok) return body.response;
+  const parsed = parseSyllabusInput(body.value);
+  if (!parsed.ok) return jsonError(parsed.error, 'BAD_REQUEST', 400);
+
+  const v = parsed.value;
+  const { data, error } = await ctx.db
+    .from('syllabus_items')
+    .upsert(
+      { subject: v.subject, chapter: v.chapter, topic: v.topic, sort_order: v.sortOrder, is_active: v.isActive, created_by: ctx.userId },
+      { onConflict: 'subject,chapter,topic' }
+    )
+    .select()
+    .single();
+  if (error || !data) {
+    console.error('[admin/syllabus] upsert:', error?.message);
+    return jsonError('Could not save syllabus item.', 'SERVER_ERROR', 500);
+  }
+  await writeAudit(ctx, 'syllabus.upsert', 'syllabus_item', data.id, { subject: v.subject, chapter: v.chapter });
+  return NextResponse.json({ item: data }, { status: 201 });
+}
+
+export async function PATCH(req: NextRequest) {
+  const ctx = await requireAdmin(req);
+  if (isErrorResponse(ctx)) return ctx;
+  const body = await readJson(req);
+  if (!body.ok) return body.response;
+  const parsed = parseSyllabusPatch(body.value);
+  if (!parsed.ok) return jsonError(parsed.error, 'BAD_REQUEST', 400);
+
+  const update: Record<string, unknown> = {};
+  if (parsed.value.isActive !== undefined) update.is_active = parsed.value.isActive;
+  if (parsed.value.sortOrder !== undefined) update.sort_order = parsed.value.sortOrder;
+
+  const { data, error } = await ctx.db.from('syllabus_items').update(update).eq('id', parsed.value.id).select().maybeSingle();
+  if (error) {
+    console.error('[admin/syllabus] update:', error.message);
+    return jsonError('Could not update syllabus item.', 'SERVER_ERROR', 500);
+  }
+  if (!data) return jsonError('Syllabus item not found.', 'NOT_FOUND', 404);
+  await writeAudit(ctx, 'syllabus.update', 'syllabus_item', parsed.value.id);
+  return NextResponse.json({ item: data });
+}
+
+export async function DELETE(req: NextRequest) {
+  const ctx = await requireAdmin(req);
+  if (isErrorResponse(ctx)) return ctx;
+  const id = new URL(req.url).searchParams.get('id');
+  if (!isUuid(id)) return jsonError('valid id is required', 'BAD_REQUEST', 400);
+  const { error } = await ctx.db.from('syllabus_items').delete().eq('id', id);
+  if (error) {
+    console.error('[admin/syllabus] delete:', error.message);
+    return jsonError('Could not delete syllabus item.', 'SERVER_ERROR', 500);
+  }
+  await writeAudit(ctx, 'syllabus.delete', 'syllabus_item', id);
+  return NextResponse.json({ ok: true });
+}
