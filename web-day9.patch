@@ -0,0 +1,27 @@
+import { timingSafeEqual } from 'node:crypto';
+import { NextRequest, NextResponse } from 'next/server';
+import { jsonError } from '@/lib/http';
+import { dispatchQueuedNotifications } from '@/lib/notifications/fcm';
+
+export const runtime = 'nodejs';
+export const dynamic = 'force-dynamic';
+export const maxDuration = 60;
+
+function safeEqual(a: string, b: string): boolean {
+  const ab = Buffer.from(a);
+  const bb = Buffer.from(b);
+  return ab.length === bb.length && timingSafeEqual(ab, bb);
+}
+
+// Retry/cron endpoint: Authorization: Bearer <CRON_SECRET>. User login se nahi chalta.
+export async function GET(req: NextRequest) {
+  const secret = process.env.CRON_SECRET;
+  const given = /^Bearer\s+(.+)$/i.exec(req.headers.get('authorization') ?? '')?.[1] ?? '';
+  if (!secret || secret.length < 16 || !safeEqual(given, secret)) return jsonError('Unauthorized', 'UNAUTHORIZED', 401);
+  try {
+    return NextResponse.json(await dispatchQueuedNotifications());
+  } catch (e) {
+    console.error('[internal/dispatch]', e instanceof Error ? e.message : e);
+    return jsonError('Dispatch failed.', 'SERVER_ERROR', 500);
+  }
+}
diff --git a/components/admin/AdminPanel.tsx b/components/admin/AdminPanel.tsx
new file mode 100644
index 0000000..dc29e8f
--- /dev/null
+++ b/components/admin/AdminPanel.tsx
@@ -0,0 +1,122 @@
+'use client';
+
+import { useCallback, useEffect, useState } from 'react';
+import type { FormEvent } from 'react';
+import { supabase } from '@/lib/supabase/client';
+
+interface Announcement { id: string; title: string; body: string; audience: string; status: string }
+
+async function adminFetch(path: string, init: RequestInit = {}) {
+  const { data } = await supabase.auth.getSession();
+  const token = data.session?.access_token;
+  const res = await fetch(path, {
+    ...init,
+    headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token ?? ''}`, ...(init.headers ?? {}) },
+  });
+  const json = await res.json().catch(() => ({}));
+  if (!res.ok) throw new Error(json.error || `Request failed (${res.status})`);
+  return json;
+}
+
+export function AdminPanel() {
+  const [isAdmin, setIsAdmin] = useState<boolean | null>(null);
+  const [items, setItems] = useState<Announcement[]>([]);
+  const [msg, setMsg] = useState<string | null>(null);
+  const [title, setTitle] = useState('');
+  const [body, setBody] = useState('');
+  const [subject, setSubject] = useState('');
+  const [chapter, setChapter] = useState('');
+  const [topic, setTopic] = useState('');
+
+  const load = useCallback(async () => {
+    try {
+      const j = await adminFetch('/api/admin/announcements');
+      setItems(j.items ?? []);
+    } catch (e) {
+      setMsg(e instanceof Error ? e.message : 'Load failed');
+    }
+  }, []);
+
+  useEffect(() => {
+    // UI hint hai; asli enforcement server (requireAdmin) + RLS karta hai
+    supabase.rpc('is_admin').then(({ data }) => {
+      setIsAdmin(data === true);
+      if (data === true) void load();
+    });
+  }, [load]);
+
+  const run = async (fn: () => Promise<unknown>, ok: string) => {
+    setMsg(null);
+    try {
+      await fn();
+      setMsg(ok);
+      await load();
+    } catch (e) {
+      setMsg(e instanceof Error ? e.message : 'Failed');
+    }
+  };
+
+  const createAnnouncement = (e: FormEvent) => {
+    e.preventDefault();
+    void run(async () => {
+      await adminFetch('/api/admin/announcements', { method: 'POST', body: JSON.stringify({ title, body }) });
+      setTitle('');
+      setBody('');
+    }, 'Draft created');
+  };
+
+  const addSyllabus = (e: FormEvent) => {
+    e.preventDefault();
+    void run(async () => {
+      await adminFetch('/api/admin/syllabus', { method: 'POST', body: JSON.stringify({ subject, chapter, topic }) });
+      setTopic('');
+    }, 'Syllabus item saved');
+  };
+
+  const field = 'w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-sm';
+
+  if (isAdmin === null) return <p className="text-center text-slate-400 mt-10 text-sm">Checking access…</p>;
+  if (!isAdmin) return <p className="text-center text-red-300 mt-10 text-sm">Access denied: admin role required.</p>;
+
+  return (
+    <div className="max-w-3xl mx-auto space-y-8">
+      <h1 className="text-xl font-bold">🛡️ Admin Panel</h1>
+      {msg && <p className="text-xs text-amber-300">{msg}</p>}
+
+      <form onSubmit={createAnnouncement} className="space-y-2 rounded-xl border border-slate-800 p-4">
+        <h2 className="font-semibold text-sm">New announcement</h2>
+        <input className={field} placeholder="Title" value={title} onChange={(e) => setTitle(e.target.value)} required minLength={3} maxLength={120} />
+        <textarea className={field} placeholder="Message" value={body} onChange={(e) => setBody(e.target.value)} required maxLength={2000} rows={3} />
+        <button className="px-4 py-2 bg-blue-600 rounded-lg text-sm font-semibold">Save draft</button>
+      </form>
+
+      <section className="space-y-2">
+        <h2 className="font-semibold text-sm">Announcements</h2>
+        {items.map((a) => (
+          <div key={a.id} className="rounded-lg border border-slate-800 p-3 text-sm flex items-start justify-between gap-3">
+            <div>
+              <p className="font-medium">{a.title} <span className="text-xs text-slate-400">· {a.status}</span></p>
+              <p className="text-xs text-slate-400 line-clamp-2">{a.body}</p>
+            </div>
+            {a.status === 'draft' && (
+              <button
+                className="px-3 py-1.5 bg-emerald-600 rounded-lg text-xs font-semibold"
+                onClick={() => void run(() => adminFetch('/api/admin/announcements', { method: 'PATCH', body: JSON.stringify({ id: a.id, publish: true }) }), 'Published & notifications queued')}
+              >
+                Publish
+              </button>
+            )}
+          </div>
+        ))}
+      </section>
+
+      <form onSubmit={addSyllabus} className="space-y-2 rounded-xl border border-slate-800 p-4">
+        <h2 className="font-semibold text-sm">Syllabus item</h2>
+        <input className={field} placeholder="Subject (e.g. Physics)" value={subject} onChange={(e) => setSubject(e.target.value)} required />
+        <input className={field} placeholder="Chapter" value={chapter} onChange={(e) => setChapter(e.target.value)} required />
+        <input className={field} placeholder="Topic" value={topic} onChange={(e) => setTopic(e.target.value)} required />
+        <button className="px-4 py-2 bg-blue-600 rounded-lg text-sm font-semibold">Save</button>
+      </form>
+    </div>
+  );
+}
diff --git a/lib/admin/validators.ts b/lib/admin/validators.ts
new file mode 100644
index 0000000..b62a5da
--- /dev/null
+++ b/lib/admin/validators.ts
@@ -0,0 +1,139 @@
+export type Result<T> = { ok: true; value: T } | { ok: false; error: string };
+
+export const AUDIENCES = ['all', 'batch', 'no_batch'] as const;
+export type Audience = (typeof AUDIENCES)[number];
+export const PLATFORMS = ['android', 'ios', 'web'] as const;
+export type Platform = (typeof PLATFORMS)[number];
+
+const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+// eslint-disable-next-line no-control-regex
+const CONTROL_RE = /[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/g;
+
+export const isUuid = (v: unknown): v is string => typeof v === 'string' && UUID_RE.test(v);
+
+function obj(raw: unknown): Record<string, unknown> {
+  return typeof raw === 'object' && raw !== null && !Array.isArray(raw) ? (raw as Record<string, unknown>) : {};
+}
+
+function text(v: unknown, min: number, max: number, field: string, multiline = false): Result<string> {
+  if (typeof v !== 'string') return { ok: false, error: `${field} is required` };
+  let s = v.replace(CONTROL_RE, '');
+  if (!multiline) s = s.replace(/[\r\n\t]+/g, ' ');
+  s = s.trim();
+  if (s.length < min) return { ok: false, error: `${field} must be at least ${min} characters` };
+  if (s.length > max) return { ok: false, error: `${field} must be at most ${max} characters` };
+  return { ok: true, value: s };
+}
+
+function audience(v: unknown): Result<Audience> {
+  if (v === undefined) return { ok: true, value: 'all' };
+  return typeof v === 'string' && (AUDIENCES as readonly string[]).includes(v)
+    ? { ok: true, value: v as Audience }
+    : { ok: false, error: 'audience must be all, batch or no_batch' };
+}
+
+export interface AnnouncementInput { title: string; body: string; audience: Audience }
+
+export function parseAnnouncementInput(raw: unknown): Result<AnnouncementInput> {
+  const r = obj(raw);
+  const title = text(r.title, 3, 120, 'title');
+  if (!title.ok) return title;
+  const body = text(r.body, 1, 2000, 'body', true);
+  if (!body.ok) return body;
+  const aud = audience(r.audience);
+  if (!aud.ok) return aud;
+  return { ok: true, value: { title: title.value, body: body.value, audience: aud.value } };
+}
+
+export interface AnnouncementPatch {
+  id: string;
+  title?: string;
+  body?: string;
+  audience?: Audience;
+  publish?: boolean;
+  archive?: boolean;
+}
+
+export function parseAnnouncementPatch(raw: unknown): Result<AnnouncementPatch> {
+  const r = obj(raw);
+  if (!isUuid(r.id)) return { ok: false, error: 'valid id is required' };
+  const out: AnnouncementPatch = { id: r.id };
+  if (r.title !== undefined) {
+    const t = text(r.title, 3, 120, 'title');
+    if (!t.ok) return t;
+    out.title = t.value;
+  }
+  if (r.body !== undefined) {
+    const b = text(r.body, 1, 2000, 'body', true);
+    if (!b.ok) return b;
+    out.body = b.value;
+  }
+  if (r.audience !== undefined) {
+    const a = audience(r.audience);
+    if (!a.ok) return a;
+    out.audience = a.value;
+  }
+  if (r.publish === true) out.publish = true;
+  if (r.archive === true) out.archive = true;
+  if (out.publish && out.archive) return { ok: false, error: 'publish and archive cannot be combined' };
+  return { ok: true, value: out };
+}
+
+export interface SyllabusInput { subject: string; chapter: string; topic: string; sortOrder: number; isActive: boolean }
+
+export function parseSyllabusInput(raw: unknown): Result<SyllabusInput> {
+  const r = obj(raw);
+  const subject = text(r.subject, 2, 50, 'subject');
+  if (!subject.ok) return subject;
+  const chapter = text(r.chapter, 2, 100, 'chapter');
+  if (!chapter.ok) return chapter;
+  const topic = text(r.topic, 1, 120, 'topic');
+  if (!topic.ok) return topic;
+  const sortOrder = r.sortOrder === undefined ? 0 : r.sortOrder;
+  if (typeof sortOrder !== 'number' || !Number.isInteger(sortOrder) || sortOrder < 0 || sortOrder > 10000) {
+    return { ok: false, error: 'sortOrder must be an integer 0-10000' };
+  }
+  if (r.isActive !== undefined && typeof r.isActive !== 'boolean') return { ok: false, error: 'isActive must be boolean' };
+  return {
+    ok: true,
+    value: { subject: subject.value, chapter: chapter.value, topic: topic.value, sortOrder, isActive: r.isActive !== false },
+  };
+}
+
+export interface SyllabusPatch { id: string; isActive?: boolean; sortOrder?: number }
+
+export function parseSyllabusPatch(raw: unknown): Result<SyllabusPatch> {
+  const r = obj(raw);
+  if (!isUuid(r.id)) return { ok: false, error: 'valid id is required' };
+  const out: SyllabusPatch = { id: r.id };
+  if (r.isActive !== undefined) {
+    if (typeof r.isActive !== 'boolean') return { ok: false, error: 'isActive must be boolean' };
+    out.isActive = r.isActive;
+  }
+  if (r.sortOrder !== undefined) {
+    if (typeof r.sortOrder !== 'number' || !Number.isInteger(r.sortOrder) || r.sortOrder < 0 || r.sortOrder > 10000) {
+      return { ok: false, error: 'sortOrder must be an integer 0-10000' };
+    }
+    out.sortOrder = r.sortOrder;
+  }
+  if (out.isActive === undefined && out.sortOrder === undefined) return { ok: false, error: 'nothing to update' };
+  return { ok: true, value: out };
+}
+
+export interface DeviceInput { token: string; platform: Platform; appVersion?: string }
+
+export function parseDeviceInput(raw: unknown): Result<DeviceInput> {
+  const r = obj(raw);
+  if (typeof r.token !== 'string' || r.token.length < 20 || r.token.length > 4096 || /\s/.test(r.token)) {
+    return { ok: false, error: 'invalid token' };
+  }
+  if (typeof r.platform !== 'string' || !(PLATFORMS as readonly string[]).includes(r.platform)) {
+    return { ok: false, error: 'invalid platform' };
+  }
+  let appVersion: string | undefined;
+  if (r.appVersion !== undefined) {
+    if (typeof r.appVersion !== 'string' || r.appVersion.length > 32) return { ok: false, error: 'invalid appVersion' };
+    appVersion = r.appVersion;
+  }
+  return { ok: true, value: { token: r.token, platform: r.platform as Platform, appVersion } };
+}
diff --git a/lib/auth/server.ts b/lib/auth/server.ts
new file mode 100644
