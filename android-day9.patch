@@ -0,0 +1,86 @@
+package com.example.device
+
+import android.content.Context
+import androidx.core.app.NotificationManagerCompat
+import androidx.work.ExistingWorkPolicy
+import androidx.work.OneTimeWorkRequestBuilder
+import androidx.work.WorkManager
+import androidx.work.workDataOf
+import com.example.ui.components.StudySlotAlarmManager
+import com.example.work.StudySlotAlarmWorker
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import java.util.Calendar
+import java.util.concurrent.TimeUnit
+
+object SnoozeScheduler {
+    sealed interface Outcome {
+        data class Scheduled(val snoozeNumber: Int, val delayMs: Long) : Outcome
+        object LimitReached : Outcome
+    }
+
+    private const val SNOOZE_PREFS = "upgrade_hub_snooze"
+    private val testScope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+
+    /** Stops the ringing drill and re-rings the same slot after [minutes] (via WorkManager, survives app kill). */
+    fun snooze(
+        context: Context,
+        slotIndex: Int,
+        slotTitle: String,
+        scheduledTimeLabel: String,
+        minutes: Int = SnoozePolicy.DEFAULT_MINUTES,
+        isTest: Boolean = false
+    ): Outcome {
+        val app = context.applicationContext
+        val cal = Calendar.getInstance()
+        val year = cal.get(Calendar.YEAR)
+        val doy = cal.get(Calendar.DAY_OF_YEAR)
+        val tracker = SnoozeTracker(PrefsKeyValueStore(app, SNOOZE_PREFS))
+
+        if (!isTest && !SnoozePolicy.canSnooze(tracker.count(year, doy, slotIndex))) {
+            return Outcome.LimitReached
+        }
+
+        StudySlotAlarmManager.stopMockDrillAudio(app)
+        try { NotificationManagerCompat.from(app).cancel(2040 + slotIndex) } catch (_: Exception) { }
+
+        val number = if (isTest) 0 else tracker.increment(year, doy, slotIndex)
+        val delayMs = if (isTest) TimeUnit.SECONDS.toMillis(SnoozePolicy.TEST_DELAY_SECONDS) else SnoozePolicy.delayMs(minutes)
+
+        val data = workDataOf(
+            StudySlotAlarmWorker.KEY_SLOT_INDEX to slotIndex,
+            StudySlotAlarmWorker.KEY_SLOT_TITLE to slotTitle,
+            StudySlotAlarmWorker.KEY_SLOT_TIME to (if (isTest) "Snooze test (+${SnoozePolicy.TEST_DELAY_SECONDS}s)" else "Snoozed from $scheduledTimeLabel"),
+            StudySlotAlarmWorker.KEY_IS_TEST to isTest,
+            StudySlotAlarmWorker.KEY_IS_SNOOZE to true,
+            // test snoozes carry no key so they always ring; real snoozes are deduplicated
+            StudySlotAlarmWorker.KEY_DEDUPE_KEY to (if (isTest) "" else SlotAlertGuard.snoozeKey(year, doy, slotIndex, number))
+        )
+        val request = OneTimeWorkRequestBuilder<StudySlotAlarmWorker>()
+            .setInitialDelay(delayMs, TimeUnit.MILLISECONDS)
+            .setInputData(data)
+            .addTag("study_slot_snooze")
+            .build()
+
+        // One pending snooze per slot: tapping Snooze twice cannot create two alarms.
+        WorkManager.getInstance(app).enqueueUniqueWork("study_slot_snooze_$slotIndex", ExistingWorkPolicy.REPLACE, request)
+        DeviceAnalytics.log(app, "slot_snoozed", mapOf("n" to number.toString(), "test" to isTest.toString()))
+        return Outcome.Scheduled(number, delayMs)
+    }
+
+    /** Manual end-to-end check: rings the drill now, auto-snoozes after 3s, rings again ~10s later. */
+    fun runSnoozeTest(context: Context) {
+        val app = context.applicationContext
+        StudySlotAlarmManager.ensureInitialized(app)
+        val title = "[SNOOZE TEST] ${StudySlotAlarmManager.getSlotConfig(0).title}"
+        StudySlotAlarmManager.startThirtySecondMockDrillAudio(app, 0, title, "Now")
+        testScope.launch {
+            delay(3_000)
+            withContext(Dispatchers.Main) { snooze(app, 0, title, "Now", isTest = true) }
+        }
+    }
+}
diff --git a/app/src/main/java/com/example/device/SupabaseDeviceRegistry.kt b/app/src/main/java/com/example/device/SupabaseDeviceRegistry.kt
new file mode 100644
index 0000000..b9eb298
--- /dev/null
+++ b/app/src/main/java/com/example/device/SupabaseDeviceRegistry.kt
@@ -0,0 +1,113 @@
+package com.example.device
+
+import android.content.Context
+import androidx.work.BackoffPolicy
+import androidx.work.Constraints
+import androidx.work.CoroutineWorker
+import androidx.work.ExistingWorkPolicy
+import androidx.work.NetworkType
+import androidx.work.OneTimeWorkRequestBuilder
+import androidx.work.WorkManager
+import androidx.work.WorkerParameters
+import com.example.BuildConfig
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.json.JSONObject
+import java.util.concurrent.TimeUnit
+
+/** Supplies the Supabase access token (JWT) of the signed-in user. Wire this when Supabase Auth lands on Android. */
+fun interface SupabaseSessionProvider {
+    suspend fun accessToken(): String?
+}
+
+/**
+ * Registers the FCM token with our backend (/api/devices/register -> Supabase `device_tokens`, RLS protected).
+ * Supabase stays the source of truth; Firebase only delivers the push.
+ */
+object SupabaseDeviceRegistry {
+    private const val PREFS = "upgrade_hub_device_registry"
+    private const val K_PENDING = "pending_token"
+    private const val WORK_NAME = "upgradehub_device_token_sync"
+    private val JSON = "application/json; charset=utf-8".toMediaType()
+    private val client by lazy {
+        OkHttpClient.Builder()
+            .callTimeout(20, TimeUnit.SECONDS)
+            .build()
+    }
+
+    @Volatile
+    var sessionProvider: SupabaseSessionProvider = SupabaseSessionProvider { null }
+
+    enum class SyncOutcome { DONE, NO_SESSION, FAILED_RETRYABLE, FAILED_PERMANENT }
+
+    fun onNewToken(context: Context, token: String) {
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .edit().putString(K_PENDING, token).apply()
+        scheduleSync(context)
+    }
+
+    fun scheduleSync(context: Context) {
+        val app = context.applicationContext
+        val hasPending = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString(K_PENDING, null) != null
+        if (!hasPending) return
+        val request = OneTimeWorkRequestBuilder<DeviceTokenSyncWorker>()
+            .setConstraints(Constraints.Builder().setRequiredNetworkType(NetworkType.CONNECTED).build())
+            .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, 30, TimeUnit.SECONDS)
+            .build()
+        WorkManager.getInstance(app).enqueueUniqueWork(WORK_NAME, ExistingWorkPolicy.REPLACE, request)
+    }
+
+    suspend fun syncPending(context: Context): SyncOutcome = withContext(Dispatchers.IO) {
+        val app = context.applicationContext
+        val prefs = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        val token = prefs.getString(K_PENDING, null) ?: return@withContext SyncOutcome.DONE
+        val jwt = sessionProvider.accessToken() ?: return@withContext SyncOutcome.NO_SESSION
+
+        val base = BuildConfig.UPGRADEHUB_API_BASE_URL.trim().trimEnd('/')
+        if (!base.startsWith("https://")) return@withContext SyncOutcome.FAILED_PERMANENT   // never send tokens over http
+
+        val body = JSONObject()
+            .put("token", token)
+            .put("platform", "android")
+            .put("appVersion", BuildConfig.VERSION_NAME)
+            .toString()
+            .toRequestBody(JSON)
+        val request = Request.Builder()
+            .url("$base/api/devices/register")
+            .addHeader("Authorization", "Bearer $jwt")
+            .post(body)
+            .build()
+
+        try {
+            client.newCall(request).execute().use { resp ->
+                when {
+                    resp.isSuccessful -> {
+                        prefs.edit().remove(K_PENDING).apply()
+                        SyncOutcome.DONE
+                    }
+                    resp.code == 401 -> SyncOutcome.NO_SESSION          // expired JWT: retry after refresh
+                    resp.code == 429 || resp.code >= 500 -> SyncOutcome.FAILED_RETRYABLE
+                    else -> SyncOutcome.FAILED_PERMANENT                 // 400/403: retrying will not help
+                }
+            }
+        } catch (_: Exception) {
+            SyncOutcome.FAILED_RETRYABLE
+        }
+    }
+}
+
+class DeviceTokenSyncWorker(context: Context, params: WorkerParameters) : CoroutineWorker(context, params) {
+    override suspend fun doWork(): Result = when (SupabaseDeviceRegistry.syncPending(applicationContext)) {
+        SupabaseDeviceRegistry.SyncOutcome.DONE -> Result.success()
+        SupabaseDeviceRegistry.SyncOutcome.NO_SESSION ->
+            // User not signed in yet: stop retrying; DeviceLayer.initialize() retries on next app start/login.
+            if (runAttemptCount >= 3) Result.success() else Result.retry()
+        SupabaseDeviceRegistry.SyncOutcome.FAILED_RETRYABLE ->
+            if (runAttemptCount >= 8) Result.failure() else Result.retry()
+        SupabaseDeviceRegistry.SyncOutcome.FAILED_PERMANENT -> Result.failure()
+    }
+}
diff --git a/app/src/main/java/com/example/device/fcm/AnnouncementNotifier.kt b/app/src/main/java/com/example/device/fcm/AnnouncementNotifier.kt
