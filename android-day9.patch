+package com.example.device
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class SnoozePolicyTest {
+    @Test fun limitsSnoozesPerDay() {
+        assertTrue(SnoozePolicy.canSnooze(0))
+        assertTrue(SnoozePolicy.canSnooze(2))
+        assertFalse(SnoozePolicy.canSnooze(3))
+        assertFalse(SnoozePolicy.canSnooze(-1))
+    }
+
+    @Test fun delayIsClamped() {
+        assertEquals(5 * 60_000L, SnoozePolicy.delayMs())
+        assertEquals(60_000L, SnoozePolicy.delayMs(0))
+        assertEquals(30 * 60_000L, SnoozePolicy.delayMs(999))
+    }
+
+    @Test fun trackerCountsPerSlotAndDay() {
+        val t = SnoozeTracker(InMemoryKeyValueStore())
+        assertEquals(0, t.count(2026, 297, 0))
+        assertEquals(1, t.increment(2026, 297, 0))
+        assertEquals(2, t.increment(2026, 297, 0))
+        assertEquals(0, t.count(2026, 297, 1))      // other slot
+        assertEquals(0, t.count(2026, 298, 0))      // next day resets
+    }
