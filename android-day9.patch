@@ -0,0 +1,59 @@
+package com.example.device
+
+import android.content.Context
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** User toggles for the study environment: haptics + ambient focus sound. */
+object DeviceFeedbackPrefs {
+    private const val PREFS = "upgrade_hub_device_feedback"
+    private const val K_HAPTICS = "haptics_enabled"
+    private const val K_AMBIENT = "ambient_enabled"
+    private const val K_VOLUME = "ambient_volume"
+
+    private val _hapticsEnabled = MutableStateFlow(true)   // default = existing behaviour (drill vibrates)
+    val hapticsEnabled: StateFlow<Boolean> = _hapticsEnabled.asStateFlow()
+
+    private val _ambientEnabled = MutableStateFlow(false)
+    val ambientEnabled: StateFlow<Boolean> = _ambientEnabled.asStateFlow()
+
+    private val _ambientVolume = MutableStateFlow(40)
+    val ambientVolume: StateFlow<Int> = _ambientVolume.asStateFlow()
+
+    @Volatile private var initialized = false
+
+    @Synchronized
+    fun ensureInitialized(context: Context) {
+        if (initialized) return
+        val p = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        _hapticsEnabled.value = p.getBoolean(K_HAPTICS, true)
+        _ambientEnabled.value = p.getBoolean(K_AMBIENT, false)
+        _ambientVolume.value = p.getInt(K_VOLUME, 40).coerceIn(0, 100)
+        initialized = true
+    }
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    fun setHapticsEnabled(context: Context, enabled: Boolean) {
+        ensureInitialized(context)
+        prefs(context).edit().putBoolean(K_HAPTICS, enabled).apply()
+        _hapticsEnabled.value = enabled
+    }
+
+    fun setAmbientEnabled(context: Context, enabled: Boolean) {
+        ensureInitialized(context)
+        prefs(context).edit().putBoolean(K_AMBIENT, enabled).apply()
+        _ambientEnabled.value = enabled
+        if (enabled) AmbientFocusPlayer.start(context) else AmbientFocusPlayer.stop()
+    }
+
+    fun setAmbientVolume(context: Context, percent: Int) {
+        ensureInitialized(context)
+        val v = percent.coerceIn(0, 100)
+        prefs(context).edit().putInt(K_VOLUME, v).apply()
+        _ambientVolume.value = v
+        AmbientFocusPlayer.applyVolume()
+    }
+}
diff --git a/app/src/main/java/com/example/device/DeviceLayer.kt b/app/src/main/java/com/example/device/DeviceLayer.kt
