@@ -0,0 +1,46 @@
+package com.example.device
+
+import android.content.Context
+import android.os.Build
+import android.os.VibrationEffect
+import android.os.Vibrator
+import android.os.VibratorManager
+
+/** Single entry point for vibration so the Haptics toggle is respected everywhere. */
+object HapticsController {
+
+    private fun vibrator(context: Context): Vibrator? {
+        val app = context.applicationContext
+        return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            (app.getSystemService(Context.VIBRATOR_MANAGER_SERVICE) as? VibratorManager)?.defaultVibrator
+        } else {
+            @Suppress("DEPRECATION")
+            app.getSystemService(Context.VIBRATOR_SERVICE) as? Vibrator
+        }
+    }
+
+    /** @return true if a vibration was started (toggle on + hardware present). */
+    fun vibratePattern(context: Context, pattern: LongArray): Boolean {
+        DeviceFeedbackPrefs.ensureInitialized(context)
+        if (!DeviceFeedbackPrefs.hapticsEnabled.value) return false
+        return try {
+            val v = vibrator(context) ?: return false
+            if (!v.hasVibrator()) return false
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                v.vibrate(VibrationEffect.createWaveform(pattern, -1))
+            } else {
+                @Suppress("DEPRECATION")
+                v.vibrate(pattern, -1)
+            }
+            true
+        } catch (_: Exception) {
+            false
+        }
+    }
+
+    fun tick(context: Context): Boolean = vibratePattern(context, longArrayOf(0, 30))
+
+    fun cancel(context: Context) {
+        try { vibrator(context)?.cancel() } catch (_: Exception) { }
+    }
+}
diff --git a/app/src/main/java/com/example/device/SlotAlertGuard.kt b/app/src/main/java/com/example/device/SlotAlertGuard.kt
new file mode 100644
index 0000000..dbfb632
--- /dev/null
+++ b/app/src/main/java/com/example/device/SlotAlertGuard.kt
@@ -0,0 +1,73 @@
+package com.example.device
+
+import android.content.Context
+
+/** Tiny persistent/in-memory long store so the guard logic is unit-testable without Android. */
+interface KeyValueStore {
+    fun getLong(key: String): Long?
+    fun putLong(key: String, value: Long)
+    fun remove(key: String)
+    fun keys(): Set<String>
+}
+
+class InMemoryKeyValueStore : KeyValueStore {
+    private val map = LinkedHashMap<String, Long>()
+    @Synchronized override fun getLong(key: String): Long? = map[key]
+    @Synchronized override fun putLong(key: String, value: Long) { map[key] = value }
+    @Synchronized override fun remove(key: String) { map.remove(key) }
+    @Synchronized override fun keys(): Set<String> = map.keys.toSet()
+}
+
+/** SharedPreferences-backed store. Use a dedicated prefs file per guard (keys() lists the whole file). */
+class PrefsKeyValueStore(context: Context, name: String) : KeyValueStore {
+    private val prefs = context.applicationContext.getSharedPreferences(name, Context.MODE_PRIVATE)
+    override fun getLong(key: String): Long? = if (prefs.contains(key)) prefs.getLong(key, 0L) else null
+    override fun putLong(key: String, value: Long) { prefs.edit().putLong(key, value).apply() }
+    override fun remove(key: String) { prefs.edit().remove(key).apply() }
+    override fun keys(): Set<String> = prefs.all.keys.toSet()
+}
+
+/**
+ * Duplicate-alert control. Every automatic trigger path (1-second foreground ticker, WorkManager worker,
+ * snooze worker, FCM) asks [tryAcquire] with a deterministic key first. Same key inside [windowMs] => false (skip).
+ */
+class SlotAlertGuard(
+    private val store: KeyValueStore,
+    private val windowMs: Long = DEFAULT_WINDOW_MS,
+    private val maxKeys: Int = 64
+) {
+    @Synchronized
+    fun tryAcquire(key: String, nowMs: Long): Boolean {
+        val last = store.getLong(key)
+        // nowMs < last => device clock moved backwards; allow instead of blocking forever.
+        if (last != null && nowMs >= last && nowMs - last < windowMs) return false
+        store.putLong(key, nowMs)
+        prune(nowMs)
+        return true
+    }
+
+    private fun prune(nowMs: Long) {
+        val all = store.keys()
+        if (all.size <= maxKeys) return
+        val stamped = all.mapNotNull { k -> store.getLong(k)?.let { k to it } }
+        stamped.filter { nowMs - it.second >= windowMs }.forEach { store.remove(it.first) }
+        val remaining = store.keys()
+        if (remaining.size > maxKeys) {
+            stamped.filter { it.first in remaining }
+                .sortedBy { it.second }
+                .take(remaining.size - maxKeys)
+                .forEach { store.remove(it.first) }
+        }
+    }
+
+    companion object {
+        const val DEFAULT_WINDOW_MS = 90_000L
+
+        /** Same key whether built by the ticker (now) or by the worker (scheduled target time). */
+        fun slotKey(year: Int, dayOfYear: Int, slotIndex: Int, hour24: Int, minute: Int): String =
+            "slot_${year}_${dayOfYear}_s${slotIndex}_${hour24}_$minute"
+
+        fun snoozeKey(year: Int, dayOfYear: Int, slotIndex: Int, snoozeNumber: Int): String =
+            "snooze_${year}_${dayOfYear}_s${slotIndex}_n$snoozeNumber"
+    }
+}
diff --git a/app/src/main/java/com/example/device/SnoozePolicy.kt b/app/src/main/java/com/example/device/SnoozePolicy.kt
