+package com.example.device
+
+import com.example.widget.NextSlotResolver
+import com.example.widget.SlotLite
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class NextSlotResolverTest {
+    private val slots = listOf(
+        SlotLite(0, "Morning", 6, 0, true),
+        SlotLite(1, "Forenoon", 10, 0, true),
+        SlotLite(2, "Afternoon", 15, 0, false),
+        SlotLite(3, "Night", 20, 0, true)
+    )
+
+    @Test fun picksNextEnabledToday() {
+        val n = NextSlotResolver.resolve(slots, 8, 30)!!
+        assertEquals(1, n.slot.index); assertEquals(90, n.minutesUntil)
+    }
+
+    @Test fun skipsDisabledSlots() {
+        assertEquals(3, NextSlotResolver.resolve(slots, 11, 0)!!.slot.index)
+    }
+
+    @Test fun wrapsPastMidnight() {
+        val n = NextSlotResolver.resolve(slots, 21, 0)!!
+        assertEquals(0, n.slot.index); assertEquals(9 * 60, n.minutesUntil)
+    }
+
+    @Test fun noneEnabledReturnsNull() {
+        assertNull(NextSlotResolver.resolve(slots.map { it.copy(enabled = false) }, 9, 0))
+    }
+
+    @Test fun countdownFormatting() {
+        assertEquals("now", NextSlotResolver.formatCountdown(0))
+        assertEquals("45m", NextSlotResolver.formatCountdown(45))
+        assertEquals("2h", NextSlotResolver.formatCountdown(120))
+        assertEquals("2h 15m", NextSlotResolver.formatCountdown(135))
+    }
+}
