diff --git a/app/src/main/java/com/example/device/AmbientFocusPlayer.kt b/app/src/main/java/com/example/device/AmbientFocusPlayer.kt
new file mode 100644
index 0000000..307bbc4
--- /dev/null
+++ b/app/src/main/java/com/example/device/AmbientFocusPlayer.kt
@@ -0,0 +1,136 @@
+package com.example.device
+
+import android.content.Context
+import android.media.AudioAttributes
+import android.media.AudioFormat
+import android.media.AudioTrack
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import java.util.Random
+
+/**
+ * Procedurally generated brown-noise "ambient focus" sound (no audio asset needed, works offline).
+ * Pauses automatically while the 30-second study-slot alarm rings and resumes afterwards.
+ */
+object AmbientFocusPlayer {
+    private const val SAMPLE_RATE = 22050
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+
+    private var job: Job? = null
+    @Volatile private var track: AudioTrack? = null
+    @Volatile private var shouldResume = false
+    @Volatile private var appContext: Context? = null
+
+    private val _playing = MutableStateFlow(false)
+    val isPlaying: StateFlow<Boolean> = _playing.asStateFlow()
+
+    @Synchronized
+    fun start(context: Context): Boolean {
+        DeviceFeedbackPrefs.ensureInitialized(context)
+        if (!DeviceFeedbackPrefs.ambientEnabled.value) return false
+        if (job?.isActive == true) return true
+
+        val minBuf = AudioTrack.getMinBufferSize(SAMPLE_RATE, AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_16BIT)
+        if (minBuf <= 0) return false
+
+        val t = try {
+            AudioTrack.Builder()
+                .setAudioAttributes(
+                    AudioAttributes.Builder()
+                        .setUsage(AudioAttributes.USAGE_MEDIA)
+                        .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
+                        .build()
+                )
+                .setAudioFormat(
+                    AudioFormat.Builder()
+                        .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                        .setSampleRate(SAMPLE_RATE)
+                        .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
+                        .build()
+                )
+                .setBufferSizeInBytes(minBuf.coerceAtLeast(SAMPLE_RATE / 2))
+                .setTransferMode(AudioTrack.MODE_STREAM)
+                .build()
+        } catch (_: Exception) {
+            return false
+        }
+        if (t.state != AudioTrack.STATE_INITIALIZED) {
+            try { t.release() } catch (_: Exception) { }
+            return false
+        }
+
+        track = t
+        applyVolume()
+        try { t.play() } catch (_: Exception) { return false }
+        _playing.value = true
+
+        job = scope.launch {
+            val buf = ShortArray(SAMPLE_RATE / 4)
+            val rnd = Random()
+            var last = 0.0
+            try {
+                while (isActive) {
+                    for (i in buf.indices) {
+                        val white = rnd.nextDouble() * 2.0 - 1.0
+                        last = (last + 0.02 * white) / 1.02          // brown noise
+                        buf[i] = (last * 3.5 * Short.MAX_VALUE * 0.5).toInt()
+                            .coerceIn(Short.MIN_VALUE.toInt(), Short.MAX_VALUE.toInt()).toShort()
+                    }
+                    if (t.write(buf, 0, buf.size) < 0) break
+                }
+            } catch (_: Exception) {
+            } finally {
+                try { t.release() } catch (_: Exception) { }
+                if (track === t) track = null
+                _playing.value = false
+            }
+        }
+        return true
+    }
+
+    @Synchronized
+    fun stop() {
+        val t = track
+        track = null
+        job?.cancel()
+        job = null
+        try { t?.stop() } catch (_: Exception) { }   // unblocks a pending write()
+        _playing.value = false
+    }
+
+    fun applyVolume() {
+        val v = (DeviceFeedbackPrefs.ambientVolume.value / 100f).coerceIn(0f, 1f) * 0.6f
+        try { track?.setVolume(v) } catch (_: Exception) { }
+    }
+
+    /** Called when the alarm siren starts. */
+    @Synchronized
+    fun suspendForAlarm(context: Context) {
+        if (job?.isActive == true) {
+            appContext = context.applicationContext
+            shouldResume = true
+            stop()
+        }
+    }
+
+    /** Called when the alarm stops. [isAlarmActive] guards against a back-to-back alarm restart. */
+    fun resumeAfterAlarm(isAlarmActive: () -> Boolean) {
+        if (!shouldResume) return
+        val app = appContext ?: return
+        scope.launch {
+            delay(600)
+            if (shouldResume && !isAlarmActive()) {
+                shouldResume = false
+                start(app)
+            }
+        }
+    }
+}
