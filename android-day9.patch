@@ -0,0 +1,51 @@
+package com.example.device
+
+import android.appwidget.AppWidgetManager
+import android.content.ComponentName
+import android.content.Context
+import com.example.device.fcm.AnnouncementNotifier
+import com.example.widget.UpgradeHubStreakWidgetProvider
+import com.example.widget.WidgetRefreshScheduler
+import com.google.firebase.messaging.FirebaseMessaging
+
+/** One call from MainActivity: wires guards, channels, widget refresh and FCM token registration. */
+object DeviceLayer {
+    @Volatile private var slotGuardInstance: SlotAlertGuard? = null
+    @Volatile private var fcmGuardInstance: SlotAlertGuard? = null
+
+    fun slotGuard(context: Context): SlotAlertGuard =
+        slotGuardInstance ?: synchronized(this) {
+            slotGuardInstance ?: SlotAlertGuard(PrefsKeyValueStore(context, "upgrade_hub_alert_guard")).also { slotGuardInstance = it }
+        }
+
+    /** 24h window: the same announcement never notifies twice on a device. */
+    fun fcmGuard(context: Context): SlotAlertGuard =
+        fcmGuardInstance ?: synchronized(this) {
+            fcmGuardInstance ?: SlotAlertGuard(
+                PrefsKeyValueStore(context, "upgrade_hub_fcm_guard"),
+                windowMs = 24L * 60 * 60 * 1000,
+                maxKeys = 200
+            ).also { fcmGuardInstance = it }
+        }
+
+    fun initialize(context: Context) {
+        val app = context.applicationContext
+        DeviceFeedbackPrefs.ensureInitialized(app)
+        AnnouncementNotifier.ensureChannel(app)
+        try {
+            val ids = AppWidgetManager.getInstance(app)
+                .getAppWidgetIds(ComponentName(app, UpgradeHubStreakWidgetProvider::class.java))
+            if (ids.isNotEmpty()) WidgetRefreshScheduler.schedulePeriodic(app)
+        } catch (_: Exception) {
+        }
+        SupabaseDeviceRegistry.scheduleSync(app)   // retry a pending token (e.g. registered before login)
+        try {
+            FirebaseMessaging.getInstance().token.addOnSuccessListener { token ->
+                if (!token.isNullOrBlank()) SupabaseDeviceRegistry.onNewToken(app, token)
+            }
+        } catch (_: Throwable) {
+            // Firebase not configured (no google-services.json): push disabled, rest of the app unaffected
+        }
+        if (DeviceFeedbackPrefs.ambientEnabled.value) AmbientFocusPlayer.start(app)
+    }
+}
diff --git a/app/src/main/java/com/example/device/HapticsController.kt b/app/src/main/java/com/example/device/HapticsController.kt
