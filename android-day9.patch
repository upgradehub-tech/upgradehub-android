@@ -0,0 +1,62 @@
+package com.example.device
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class SlotAlertGuardTest {
+    private fun guard(window: Long = 90_000L, max: Int = 64) = SlotAlertGuard(InMemoryKeyValueStore(), window, max)
+
+    @Test fun tickerAndWorkerWithSameKeyRingOnce() {
+        val g = guard()
+        val key = SlotAlertGuard.slotKey(2026, 297, 0, 6, 0)
+        assertTrue(g.tryAcquire(key, 1_000))        // foreground ticker fires first
+        assertFalse(g.tryAcquire(key, 4_000))       // WorkManager worker arrives seconds later => suppressed
+    }
+
+    @Test fun workerRunningMinutesLateStillMatchesTickerKey() {
+        // key is built from the SCHEDULED time, not from "now"
+        assertEquals(SlotAlertGuard.slotKey(2026, 297, 1, 10, 0), SlotAlertGuard.slotKey(2026, 297, 1, 10, 0))
+    }
+
+    @Test fun differentSlotsDaysAndTimesAreIndependent() {
+        val g = guard()
+        assertTrue(g.tryAcquire(SlotAlertGuard.slotKey(2026, 297, 0, 6, 0), 0))
+        assertTrue(g.tryAcquire(SlotAlertGuard.slotKey(2026, 297, 1, 6, 0), 0))   // other slot, same minute
+        assertTrue(g.tryAcquire(SlotAlertGuard.slotKey(2026, 298, 0, 6, 0), 0))   // next day
+        assertTrue(g.tryAcquire(SlotAlertGuard.slotKey(2026, 297, 0, 7, 0), 0))   // time edited
+    }
+
+    @Test fun snoozeKeysNeverCollideWithSlotKeysOrEachOther() {
+        val slot = SlotAlertGuard.slotKey(2026, 297, 0, 6, 0)
+        val s1 = SlotAlertGuard.snoozeKey(2026, 297, 0, 1)
+        val s2 = SlotAlertGuard.snoozeKey(2026, 297, 0, 2)
+        assertNotEquals(slot, s1); assertNotEquals(s1, s2)
+        val g = guard()
+        assertTrue(g.tryAcquire(slot, 0)); assertTrue(g.tryAcquire(s1, 1)); assertTrue(g.tryAcquire(s2, 2))
+        assertFalse(g.tryAcquire(s1, 3))            // same snooze delivered twice => once
+    }
+
+    @Test fun allowedAgainAfterWindowExpires() {
+        val g = guard(window = 90_000L)
+        assertTrue(g.tryAcquire("k", 0))
+        assertFalse(g.tryAcquire("k", 89_999))
+        assertTrue(g.tryAcquire("k", 90_000))
+    }
+
+    @Test fun clockMovingBackwardsDoesNotBlockForever() {
+        val g = guard()
+        assertTrue(g.tryAcquire("k", 1_000_000))
+        assertTrue(g.tryAcquire("k", 500))
+    }
+
+    @Test fun storeStaysBounded() {
+        val store = InMemoryKeyValueStore()
+        val g = SlotAlertGuard(store, windowMs = 1_000_000, maxKeys = 10)
+        for (i in 0 until 100) g.tryAcquire("k$i", i.toLong())
+        assertTrue(store.keys().size <= 10)
+        assertFalse(g.tryAcquire("k99", 200))       // newest kept
+    }
+}
