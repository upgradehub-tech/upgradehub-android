+++ b/app/src/main/java/com/example/device/SnoozePolicy.kt
@@ -0,0 +1,25 @@
+package com.example.device
+
+object SnoozePolicy {
+    const val DEFAULT_MINUTES = 5
+    const val MAX_SNOOZES_PER_SLOT_PER_DAY = 3
+    const val TEST_DELAY_SECONDS = 10L
+
+    fun canSnooze(alreadySnoozed: Int): Boolean = alreadySnoozed in 0 until MAX_SNOOZES_PER_SLOT_PER_DAY
+
+    fun delayMs(minutes: Int = DEFAULT_MINUTES): Long = minutes.coerceIn(1, 30) * 60_000L
+}
+
+/** Counts snoozes per slot per day so "snooze forever" is impossible. */
+class SnoozeTracker(private val store: KeyValueStore) {
+    private fun key(year: Int, dayOfYear: Int, slotIndex: Int) = "snz_${year}_${dayOfYear}_s$slotIndex"
+
+    fun count(year: Int, dayOfYear: Int, slotIndex: Int): Int =
+        (store.getLong(key(year, dayOfYear, slotIndex)) ?: 0L).toInt()
+
+    fun increment(year: Int, dayOfYear: Int, slotIndex: Int): Int {
+        val next = count(year, dayOfYear, slotIndex) + 1
+        store.putLong(key(year, dayOfYear, slotIndex), next.toLong())
+        return next
+    }
+}
