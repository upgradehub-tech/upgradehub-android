new file mode 100644
index 0000000..6f1caaf
--- /dev/null
+++ b/app/src/main/java/com/example/widget/NextSlotResolver.kt
@@ -0,0 +1,24 @@
+package com.example.widget
+
+data class SlotLite(val index: Int, val title: String, val hour24: Int, val minute: Int, val enabled: Boolean)
+data class NextSlot(val slot: SlotLite, val minutesUntil: Int)
+
+object NextSlotResolver {
+    /** Next enabled slot from "now", wrapping past midnight. Ties => lower index. Null if none enabled. */
+    fun resolve(slots: List<SlotLite>, nowHour: Int, nowMinute: Int): NextSlot? {
+        val nowMin = nowHour * 60 + nowMinute
+        return slots.filter { it.enabled }
+            .map { s ->
+                val t = s.hour24 * 60 + s.minute
+                NextSlot(s, ((t - nowMin) % 1440 + 1440) % 1440)
+            }
+            .minWithOrNull(compareBy<NextSlot>({ it.minutesUntil }, { it.slot.index }))
+    }
+
+    fun formatCountdown(minutes: Int): String = when {
+        minutes <= 0 -> "now"
+        minutes < 60 -> "${minutes}m"
+        minutes % 60 == 0 -> "${minutes / 60}h"
+        else -> "${minutes / 60}h ${minutes % 60}m"
+    }
+}
