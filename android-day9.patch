@@ -0,0 +1,55 @@
+package com.example.widget
+
+import android.content.Context
+import androidx.work.CoroutineWorker
+import androidx.work.ExistingPeriodicWorkPolicy
+import androidx.work.PeriodicWorkRequestBuilder
+import androidx.work.WorkManager
+import androidx.work.WorkerParameters
+import com.example.ui.components.StudySlotAlarmManager
+import java.util.Calendar
+import java.util.concurrent.TimeUnit
+
+class WidgetRefreshWorker(context: Context, params: WorkerParameters) : CoroutineWorker(context, params) {
+    override suspend fun doWork(): Result = try {
+        WidgetRefreshScheduler.refreshNow(applicationContext)
+        Result.success()
+    } catch (_: Exception) {
+        Result.retry()
+    }
+}
+
+object WidgetRefreshScheduler {
+    private const val PERIODIC = "upgradehub_widget_refresh"
+
+    /** 30 min is a battery-friendly cadence (WorkManager minimum is 15). KEEP => no duplicate schedules. */
+    fun schedulePeriodic(context: Context) {
+        val request = PeriodicWorkRequestBuilder<WidgetRefreshWorker>(30, TimeUnit.MINUTES).build()
+        WorkManager.getInstance(context.applicationContext)
+            .enqueueUniquePeriodicWork(PERIODIC, ExistingPeriodicWorkPolicy.KEEP, request)
+    }
+
+    fun cancelPeriodic(context: Context) {
+        WorkManager.getInstance(context.applicationContext).cancelUniqueWork(PERIODIC)
+    }
+
+    fun refreshNow(context: Context) {
+        val app = context.applicationContext
+        StudySlotAlarmManager.ensureInitialized(app)
+        val slots = StudySlotAlarmManager.slotConfigs.value.map {
+            SlotLite(it.slotIndex, it.title, it.hour24, it.minute, it.isEnabled)
+        }
+        val cal = Calendar.getInstance()
+        val next = NextSlotResolver.resolve(slots, cal.get(Calendar.HOUR_OF_DAY), cal.get(Calendar.MINUTE))
+        if (next != null) {
+            val time = com.example.ui.components.formatTime12Hour(next.slot.hour24, next.slot.minute)
+            UpgradeHubStreakWidgetProvider.updateNextSlot(
+                app,
+                "Next: ${next.slot.title}",
+                "$time • in ${NextSlotResolver.formatCountdown(next.minutesUntil)} • Tap to open"
+            )
+        } else {
+            UpgradeHubStreakWidgetProvider.updateNextSlot(app, "No active study slots", "Add a slot to get reminders")
+        }
+    }
+}
