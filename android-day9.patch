+                    onValueChange = { DeviceFeedbackPrefs.setAmbientVolume(context, it.toInt()) },
+                    valueRange = 0f..100f,
+                    modifier = Modifier.testTag("ambient_volume_slider")
+                )
+            }
+
+            ToggleRow(
+                title = "Haptics",
+                subtitle = "Vibration for the study-slot alarm and drills",
+                checked = haptics,
+                tag = "haptics_switch"
+            ) {
+                DeviceFeedbackPrefs.setHapticsEnabled(context, it)
+                if (it) HapticsController.tick(context)
+            }
+
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                OutlinedButton(
+                    onClick = {
+                        val ok = HapticsController.vibratePattern(context, longArrayOf(0, 150, 100, 150))
+                        Toast.makeText(
+                            context,
+                            if (ok) "Haptics OK" else "Haptics off or not supported on this device",
+                            Toast.LENGTH_SHORT
+                        ).show()
+                    },
+                    modifier = Modifier.testTag("test_haptics_btn")
+                ) { Text("Test haptics", fontSize = 11.sp) }
+
+                OutlinedButton(
+                    onClick = {
+                        SnoozeScheduler.runSnoozeTest(context)
+                        Toast.makeText(
+                            context,
+                            "Snooze test: alarm rings now, snoozes in 3s, rings again ~${SnoozePolicy.TEST_DELAY_SECONDS}s later",
+                            Toast.LENGTH_LONG
+                        ).show()
+                    },
+                    modifier = Modifier.testTag("test_snooze_btn")
+                ) { Text("Snooze test (${SnoozePolicy.TEST_DELAY_SECONDS}s)", fontSize = 11.sp) }
+            }
+        }
+    }
+}
+
+@Composable
+private fun ToggleRow(
+    title: String,
+    subtitle: String,
+    checked: Boolean,
+    tag: String,
+    onChange: (Boolean) -> Unit
+) {
+    Row(
+        modifier = Modifier.fillMaxWidth(),
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.SpaceBetween
+    ) {
+        Column(modifier = Modifier.weight(1f).padding(end = 8.dp)) {
+            Text(text = title, fontSize = 13.sp, fontWeight = FontWeight.Bold)
+            Text(text = subtitle, fontSize = 10.sp, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        }
+        Switch(checked = checked, onCheckedChange = onChange, modifier = Modifier.testTag(tag))
+    }
+}
