+    val context = LocalContext.current
+    DeviceFeedbackPrefs.ensureInitialized(context)
+    val haptics by DeviceFeedbackPrefs.hapticsEnabled.collectAsState()
+    val ambient by DeviceFeedbackPrefs.ambientEnabled.collectAsState()
+    val volume by DeviceFeedbackPrefs.ambientVolume.collectAsState()
+
+    Surface(
