@@ -0,0 +1,26 @@
+package com.example.device
+
+import android.content.Context
+import android.os.Bundle
+import com.google.firebase.analytics.FirebaseAnalytics
+import com.google.firebase.crashlytics.FirebaseCrashlytics
+
+/**
+ * Firebase is used ONLY for mobile telemetry (Analytics + Crashlytics) and FCM.
+ * Source of truth for users/data/roles = Supabase. Never put PII in params.
+ * Safe no-op if google-services.json is missing.
+ */
+object DeviceAnalytics {
+    fun log(context: Context, event: String, params: Map<String, String> = emptyMap()) {
+        try {
+            val b = Bundle()
+            params.forEach { (k, v) -> b.putString(k.take(40), v.take(100)) }
+            FirebaseAnalytics.getInstance(context.applicationContext).logEvent(event.take(40), b)
+        } catch (_: Throwable) {
+        }
+    }
+
+    fun recordNonFatal(t: Throwable) {
+        try { FirebaseCrashlytics.getInstance().recordException(t) } catch (_: Throwable) { }
+    }
+}
