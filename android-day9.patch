--- /dev/null
+++ b/app/src/main/java/com/example/device/fcm/UpgradeHubMessagingService.kt
@@ -0,0 +1,26 @@
+package com.example.device.fcm
+
+import com.example.device.DeviceAnalytics
+import com.example.device.SupabaseDeviceRegistry
+import com.google.firebase.messaging.FirebaseMessagingService
+import com.google.firebase.messaging.RemoteMessage
+
+/**
+ * FCM is only the delivery pipe. Tokens go to Supabase via [SupabaseDeviceRegistry].
+ * Note: when the app is in the background, Android shows `notification` payloads itself
+ * (tagged with dedupe_key => repeats replace); this callback covers foreground delivery.
+ */
+class UpgradeHubMessagingService : FirebaseMessagingService() {
+
+    override fun onNewToken(token: String) {
+        SupabaseDeviceRegistry.onNewToken(applicationContext, token)
+    }
+
+    override fun onMessageReceived(message: RemoteMessage) {
+        val key = message.data["dedupe_key"] ?: message.messageId ?: return
+        val title = message.notification?.title ?: message.data["title"] ?: return
+        val body = message.notification?.body ?: message.data["body"].orEmpty()
+        val shown = AnnouncementNotifier.show(applicationContext, key, title, body)
+        DeviceAnalytics.log(applicationContext, "push_received", mapOf("shown" to shown.toString()))
+    }
+}
